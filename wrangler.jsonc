{
  // Cloudflare Workers configuration for CrewAI API Gateway
  // This Worker serves as an API gateway for the CrewAI Python backend
  
  "name": "crewai-api-gateway",
  "type": "service",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "streams_enable_constructors"
  ],
  
  // Environment variables (non-sensitive)
  "vars": {
    "LOG_LEVEL": "debug",
    "REQUEST_TIMEOUT": "30000",
    "MAX_BODY_SIZE": "10485760",
    "ENABLE_CORS": "true"
  },
  
  // Secrets (set via 'wrangler secret put' command)
  "env": {
    "production": {
      "name": "crewai-api-gateway-prod",
      "routes": [
        {
          "pattern": "api.shaheen-ai.com/*",
          "zone_name": "shaheen-ai.com"
        }
      ],
      "vars": {
        "LOG_LEVEL": "info",
        "ENVIRONMENT": "production",
        "API_TIMEOUT": "30000"
      }
    },
    "staging": {
      "name": "crewai-api-gateway-staging",
      "routes": [
        {
          "pattern": "staging-api.shaheen-ai.com/*",
          "zone_name": "shaheen-ai.com"
        }
      ],
      "vars": {
        "LOG_LEVEL": "debug",
        "ENVIRONMENT": "staging",
        "API_TIMEOUT": "30000"
      }
    },
    "development": {
      "name": "crewai-api-gateway-dev",
      "vars": {
        "LOG_LEVEL": "debug",
        "ENVIRONMENT": "development",
        "API_TIMEOUT": "30000"
      }
    }
  },
  
  // KV Namespace for caching
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "crewai-cache-kv",
      "preview_id": "crewai-cache-preview"
    },
    {
      "binding": "CONFIG",
      "id": "crewai-config-kv",
      "preview_id": "crewai-config-preview"
    }
  ],
  
  // D1 Database for rate limiting & session tracking
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crewai-main",
      "database_id": "crewai-main-db"
    }
  ],
  
  // R2 Bucket for file storage
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "crewai-files",
      "preview_bucket_name": "crewai-files-preview"
    }
  ],
  
  // Durable Objects for session management
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionManager",
        "script_name": "crewai-api-gateway"
      }
    ]
  },
  
  // Queues for background tasks
  "queues": {
    "consumers": [
      {
        "queue": "crewai-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "dead_letter_queue": "crewai-tasks-dlq",
        "max_retries": 3,
        "max_concurrency": 5
      }
    ]
  },
  
  // Build configuration
  "build": {
    "command": "npm run build:worker",
    "cwd": "./",
    "watch_paths": ["src/worker/**/*.ts"]
  },
  
  // Security headers and middleware
  "env_strategy": "override_json",
  
  // Observability
  "observability": {
    "enabled": true
  },
  
  // Triggers
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  
  // Analytics Engine
  "analytics_engine_datasets": []
}
