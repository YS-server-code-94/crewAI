# Cloudflare-Specific Environment Variables
# Set these using: wrangler secret put VARIABLE_NAME

# ============================================
# SECRETS (use 'wrangler secret put' for these)
# ============================================

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
JWT_SECRET=
BACKEND_URL=https://api.backend.example.com

# ============================================
# DEVELOPMENT ENVIRONMENT (.env.local)
# ============================================
# These are set in wrangler.toml vars section:

LOG_LEVEL=debug
ENVIRONMENT=development
REQUEST_TIMEOUT=30000
MAX_BODY_SIZE=10485760
ENABLE_CORS=true

# ============================================
# STAGING ENVIRONMENT (--env staging)
# ============================================
# Set via: wrangler deploy --env staging

# LOG_LEVEL=info
# ENVIRONMENT=staging
# REQUEST_TIMEOUT=30000

# ============================================
# PRODUCTION ENVIRONMENT (--env production)
# ============================================
# Set via: wrangler deploy --env production

# LOG_LEVEL=warn
# ENVIRONMENT=production
# REQUEST_TIMEOUT=30000

# ============================================
# HOW TO SET SECRETS
# ============================================

# 1. For development:
#    wrangler secret put OPENAI_API_KEY --env development
#    wrangler secret put BACKEND_URL --env development

# 2. For staging:
#    wrangler secret put OPENAI_API_KEY --env staging

# 3. For production:
#    wrangler secret put OPENAI_API_KEY --env production

# ============================================
# RESOURCE IDs (set in wrangler.jsonc)
# ============================================

# D1_DATABASE_ID=crewai-main-db
# KV_CACHE_NAMESPACE_ID=crewai-cache-kv
# KV_CONFIG_NAMESPACE_ID=crewai-config-kv
# R2_BUCKET_NAME=crewai-files
