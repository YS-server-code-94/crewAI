# CrewAI Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Python backend URL (for local development)
BACKEND_URL=http://localhost:8000

# ============================================
# AI PROVIDER API KEYS
# ============================================

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Anthropic Claude API Key (optional)
ANTHROPIC_API_KEY=

# Google AI API Key (optional)
GOOGLE_API_KEY=

# OpenRouter API Key (optional)
OPENROUTER_API_KEY=

# ============================================
# CLOUDFLARE CONFIGURATION
# ============================================

# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token (for deployments)
CLOUDFLARE_API_TOKEN=

# D1 Database ID
D1_DATABASE_ID=crewai-main-db

# KV Namespace IDs
KV_CACHE_NAMESPACE_ID=crewai-cache-kv
KV_CONFIG_NAMESPACE_ID=crewai-config-kv

# R2 Bucket name
R2_BUCKET_NAME=crewai-files

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Maximum request body size in bytes
MAX_BODY_SIZE=10485760

# Enable CORS
ENABLE_CORS=true

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string (for external database)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Redis connection string (for caching/sessions)
REDIS_URL=

# ============================================
# SECURITY
# ============================================

# JWT Secret for token signing
JWT_SECRET=your-secret-key-here

# API Key for authentication
API_KEY=

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Analytics tracking enabled
ENABLE_ANALYTICS=true

# ============================================
# FEATURE FLAGS
# ============================================

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Maximum crew execution time (seconds)
MAX_EXECUTION_TIME=3600
